[Unit]
Description=Daily RiskOps recovery package

[Timer]
# Usually later than the plain backup. The shared service lock serializes
# overlapping or boot catch-up runs; the timer times alone do not ensure order.
OnCalendar=*-*-* 03:45:00 UTC
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
